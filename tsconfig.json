{
	"compilerOptions": {
		"target": "es2024",
		"module": "nodenext",
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"types": ["node"],
		"noEmit": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": ["src", "test", "scripts"]
}
