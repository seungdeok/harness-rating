{
	"name": "harness-rating",
	"version": "0.0.0",
	"description": "Rate a repository's AI coding agent harness from L0 to L4, with every check traced to a primary source.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"harness-rating": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc",
		"lint": "biome check",
		"test": "vitest run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/node": "26.6.6",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	}
}
