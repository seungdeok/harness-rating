{
	"name": "harness-rating",
	"version": "0.0.0",
	"description": "Rate a repository's AI coding agent harness from L0 to L4, with every check traced to a primary source.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/seungdeok/harness-rating.git"
	},
	"type": "module",
	"bin": {
		"harness-rating": "dist/cli.js"
	},
	"files": [
		"dist",
		"rubric/schema.json",
		"rubric/v0.1.yaml",
		"rubric/validate.cjs"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "npm run generate:rubric-validator && tsc -p tsconfig.build.json",
		"typecheck": "tsc",
		"lint": "biome check",
		"test": "npm run generate:rubric-validator && vitest run",
		"validate:rubric": "npm run generate:rubric-validator && node src/rubric/validate-cli.ts",
		"generate:rubric-validator": "node scripts/compile-rubric-schema.mjs",
		"generate:rubric-docs": "npm run generate:rubric-validator && node scripts/gen-rubric-docs.ts",
		"check:rubric-docs": "npm run generate:rubric-validator && node scripts/gen-rubric-docs.ts --check",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/node": "26.6.6",
		"typescript": "7.0.2",
		"vitest": "5.1.0",
		"ajv": "^8.20.0"
	},
	"dependencies": {
		"yaml": "^2.9.1"
	}
}
